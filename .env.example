# Generate independent long random values; never commit the resulting .env file.
# MC_MCP_TOKEN is for the Agent MCP client. MC_ADMIN_TOKEN is only for operators
# approving high-risk requests and must be different from MC_MCP_TOKEN.
MC_RCON_PASSWORD=replace-with-a-random-rcon-password
MC_MCP_TOKEN=replace-with-a-long-random-token-at-least-32-characters
MC_ADMIN_TOKEN=replace-with-a-different-admin-token-at-least-32-chars

